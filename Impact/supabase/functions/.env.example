# Edge Function secrets — server-side only. Set in production with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in hosted
# Supabase Edge Functions; set them here only for `supabase functions serve`.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
# Anthropic API key used by classify-news and generate-impact.
AI_API_KEY=PASTE_AI_API_KEY_HERE
# Optional: override the model (default claude-opus-5).
# AI_MODEL=claude-opus-5
# Optional: shared secret a scheduler can send as the x-cron-secret header.
# CRON_SECRET=PASTE_A_LONG_RANDOM_STRING
